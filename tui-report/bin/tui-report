#!/bin/sh
# Sync the agent's latest memory, then print its check-in in the
# terminal: last 24 hours, next 24, blocked. Colorizes the report's
# landmark lines when stdout is a TTY; plain when piped or redirected.
# Run from the agent repository.
openroutines sync || exit
if [ -t 1 ]; then
  esc=$(printf '\033')
  OPENROUTINES_LOG_LEVEL=warn openroutines routines run tui-report --no-memory | sed \
    -e "s/^\( *\)LAST 24 HOURS\$/\1${esc}[1;36mLAST 24 HOURS${esc}[0m/" \
    -e "s/^\( *\)NEXT 24 HOURS\$/\1${esc}[1;36mNEXT 24 HOURS${esc}[0m/" \
    -e "s/^\( *\)BLOCKED\$/\1${esc}[1;31mBLOCKED${esc}[0m/" \
    -e "s/^──*\$/${esc}[2m&${esc}[0m/"
else
  OPENROUTINES_LOG_LEVEL=warn openroutines routines run tui-report --no-memory
fi
